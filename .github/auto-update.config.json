{
  "relays": {
    "max": 4
  },
  "ccswitch": {
    "version": "v5.11.3",
    "listen_port": 15721
  },
  "claude_code_version": "2.1.305",
  "claude": {
    "max_turns": 60,
    "max_budget_usd": 1000,
    "timeout_minutes": 12
